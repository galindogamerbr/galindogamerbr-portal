/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: DENY
  # CSP tirada por ora — bloqueou recursos em teste real no browser (ver PR)
  # e não dá pra validar direito sem sessão interativa de browser. Os outros
  # headers acima não têm esse risco (não afetam carregamento de recurso).
