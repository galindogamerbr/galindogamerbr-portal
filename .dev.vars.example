# Copie para .dev.vars (gitignored) e preencha para rodar `wrangler pages dev` localmente.
RESEND_API_KEY=
SESSION_SECRET=dev-secret-troque-em-producao
OTP_PEPPER=dev-pepper-troque-em-producao

# Sobrescreve o ENVIRONMENT="production" do wrangler.toml só localmente —
# em dev, resend.ts faz console.log do código OTP em vez de enviar e-mail.
ENVIRONMENT=development

# Não é secreto (id público do canal), mas fica fora do wrangler.toml pra
# não commitar config de ambiente junto do código — mesmo valor em produção.
YOUTUBE_CHANNEL_ID=UCZGlbfvpoitCSFTsWVWVAow

# Métricas de comunidade (functions/api/community-stats.ts). Seguidores por
# rede são coletados por scraping/endpoints públicos (workers/social-stats-cron),
# sem API key. Só as visitas do site (Cloudflare Web Analytics) usam credenciais.
# Não é secreto — código de convite público do servidor Discord.
DISCORD_INVITE_CODE=JggtZ7qGY3
# API Token da Cloudflare com escopo Zone.Analytics:Read (dash.cloudflare.com/profile/api-tokens).
# Nome diferente de CLOUDFLARE_API_TOKEN (usado no deploy) de propósito —
# são tokens diferentes, esse só precisa de leitura de Zone Analytics.
CLOUDFLARE_ANALYTICS_API_TOKEN=
# Zone Tag do domínio (Cloudflare dashboard > domínio > Overview, lado direito).
CLOUDFLARE_ZONE_TAG=
