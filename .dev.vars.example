# Copie para .dev.vars (gitignored) e preencha para rodar `wrangler pages dev` localmente.
RESEND_API_KEY=
SESSION_SECRET=dev-secret-troque-em-producao
OTP_PEPPER=dev-pepper-troque-em-producao

# Sobrescreve o ENVIRONMENT="production" do wrangler.toml só localmente —
# em dev, resend.ts faz console.log do código OTP em vez de enviar e-mail.
ENVIRONMENT=development

# Não é secreto (id público do canal), mas fica fora do wrangler.toml pra
# não commitar config de ambiente junto do código — mesmo valor em produção.
YOUTUBE_CHANNEL_ID=UCZGlbfvpoitCSFTsWVWVAow
# API key da YouTube Data API v3 (Google Cloud Console → habilitar
# "YouTube Data API v3" → Credentials → Create API key). Usada só pro
# número de espectadores ao vivo (functions/lib/youtube.ts).
YOUTUBE_API_KEY=
# Valida a assinatura HMAC-SHA1 (header X-Hub-Signature) das notificações
# WebSub/PubSubHubbub do YouTube (functions/api/webhooks/youtube.ts) — string
# arbitrária escolhida por você, não vem do Google. Mesmo valor precisa estar
# configurado como secret do worker (workers/social-stats-cron,
# YOUTUBE_PUBSUB_SECRET), que é quem envia esse valor como hub.secret ao se
# inscrever (src/youtubePubsub.ts).
YOUTUBE_PUBSUB_SECRET=

# API Token da Cloudflare com escopo "Account Analytics" → Read (dash.cloudflare.com/profile/api-tokens).
# Nome diferente de CLOUDFLARE_API_TOKEN (usado no deploy) de propósito —
# são tokens diferentes, esse só precisa de leitura de Account Analytics.
CLOUDFLARE_ANALYTICS_API_TOKEN=
# Account ID da Cloudflare (dashboard > qualquer domínio > Overview, lado
# direito — é o mesmo pra todos os domínios da conta).
CLOUDFLARE_ACCOUNT_ID=

# Instagram (functions/api/admin/instagram/connect.ts) — sem fluxo OAuth
# próprio. Gere um token de acesso do Instagram no App Dashboard da Meta
# (Casos de uso → Gerenciar mensagens e conteúdo no Instagram → "Gerar
# tokens de acesso" → conta → "Gerar token") e cole em /admin/instagram
# junto com o ID da conta. O worker (workers/social-stats-cron) renova o
# token sozinho depois via ig_refresh_token.
# String arbitrária escolhida por você (não vem da Meta) — coloca o mesmo
# valor no campo "Verificar token" ao configurar o produto Webhooks no
# painel do app. Usado só pelo handshake de verificação em
# functions/api/webhooks/instagram.ts; não processamos eventos de verdade.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Opcional — App Secret do app na Meta (Configurações do app > Básico).
# Sem isso, o webhook de Instagram aceita qualquer POST (ok hoje, já que
# não processamos evento nenhum). Assim que alguma lógica real for
# plugada em functions/api/webhooks/instagram.ts, configura esse secret
# pra passar a exigir a assinatura x-hub-signature-256.
INSTAGRAM_APP_SECRET=

# Espectadores ao vivo da Twitch (functions/lib/twitch.ts) — Client ID/
# Secret do app criado em dev.twitch.tv/console/apps. Só credencial de
# aplicativo (client_credentials), dado público, sem login de ninguém.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Status ao vivo/espectadores do Kick (functions/lib/kick.ts) — Client ID/
# Secret do app criado em kick.com/settings/developer (API oficial, mesmo
# espírito da Twitch: client_credentials, dado público, sem login de
# ninguém). Não dá pra pegar seguidores por aqui (a API oficial não expõe
# esse campo) — isso continua vindo do endpoint interno usado pelo worker.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# OAuth do TikTok (functions/api/admin/tiktok/*.ts) — Client Key e Client
# Secret do app criado em developers.tiktok.com (produto "Login Kit").
# Conectar uma vez em /admin/tiktok; o worker (workers/social-stats-cron)
# renova o token sozinho depois.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Function key do Azure Function fs25-discord-monitor (functions/lib/farmStatus.ts,
# card de status do servidor em /fazenda) — https://fs25-discord-monitor.azurewebsites.net/api/status
# exige esse code como query param (auth level "function"). Pegue em
# portal.azure.com → a Function App → Functions → status → "Get Function Url".
FS25_MONITOR_FUNCTION_CODE=
