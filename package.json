{
  "name": "galindogamerbr-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler pages dev dist --port=8788",
    "dev:full": "concurrently -k -n vite,wrangler \"npm run dev\" \"wrangler pages dev --port=8788 --proxy 5173\"",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=galindogamerbr-portal",
    "db:migrate:local": "wrangler d1 migrations apply galindogamerbr_hub --local",
    "db:migrate:remote": "wrangler d1 migrations apply galindogamerbr_hub --remote",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^6.4.3",
    "wrangler": "^4.86.0"
  }
}
