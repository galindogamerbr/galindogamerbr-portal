{
  "name": "galindogamerbr-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently -k -n vite,dist,wrangler \"npm run dev:client\" \"npm run dev:dist\" \"wrangler pages dev dist --port=8788\"",
    "dev:client": "vite",
    "dev:dist": "vite build --watch",
    "dev:worker": "npm run build && wrangler pages dev dist --port=8788",
    "dev:full": "npm run dev",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=galindogamerbr-portal",
    "db:migrate:local": "wrangler d1 migrations apply galindogamerbr_hub --local",
    "db:migrate:remote": "wrangler d1 migrations apply galindogamerbr_hub --remote",
    "db:sync-from-prod": "node scripts/db-sync-from-prod.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "html-to-image": "^1.11.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.80.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
